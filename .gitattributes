# Windows sources keep CRLF in the working tree regardless of the clone's core.autocrlf;
# the cross-platform Rust core, WPS add-in and container files use LF.
* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md text eol=crlf
*.manifest text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.xml text eol=lf
Dockerfile text eol=lf
.node-version text eol=lf
.python-version text eol=lf
*.docx binary
*.png binary
*.deb binary
